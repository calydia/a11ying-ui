{
  "name": "a11ying-ui",
  "version": "2.0.14",
  "description": "Shared design system for A11ying brand sites",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind": "./dist/tailwind.config.cjs",
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/global.css"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.css"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build --config vite.config.build.ts && tsc --emitDeclarationOnly",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit": "vitest run src/**/*.test.ts",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:storybook:update": "playwright test --config playwright.storybook.config.ts --update-snapshots"
  },
  "keywords": [],
  "author": "Sanna Kramsi",
  "license": "MIT",
  "dependencies": {
    "qs-esm": "^8.0.2",
    "sanitize-html": "^2.18.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/satisfy": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.61.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
